# ── Gemini (Gespräch + Extraktion) ─────────────────────────────
# Pflicht. Produktions-Key mit aktivierter Abrechnung (Pay-as-you-go) nutzen:
# https://aistudio.google.com/apikey — Free Tier ist für den Produktivbetrieb
# tabu (DSGVO: nur mit Abrechnung trainiert Google nicht mit den Anruferdaten).
GEMINI_API_KEY=

# Modell für die Extraktion nach dem Auflegen (Default: gemini-3.6-flash).
# gemini-2.5-flash ist für neu angelegte Accounts abgeschaltet ("no longer
# available to new users") — es steht zwar noch in der Modell-Liste, liefert
# beim Aufruf aber 404. Der Startup-Check ruft das Modell deshalb wirklich auf.
GEMINI_MODEL=gemini-3.6-flash

# Live-Modell und Stimme für das Gespräch (Telefon UND Browser-Test-UI).
# Live-Stimmen z. B.: Kore, Leda, Aoede, Puck, Charon, Zephyr
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Kore

# Kontext-Kompression der Live-Session (Token). Hebt das 15-Minuten-Limit
# für Audio-Sessions auf und deckelt die Kosten: abgerechnet wird pro Turn
# über das gesamte Kontextfenster, und Audio wächst mit ~25 Token/Sekunde.
# Kleiner = billiger, aber kürzeres Gesprächsgedächtnis. Defaults reichen.
LIVE_COMPRESS_TRIGGER=12800
LIVE_COMPRESS_TARGET=6400

# ── E-Mail ─────────────────────────────────────────────────────
# Der Voice-Agent sendet VOM eigenen Postfach voice-agent@tanzschule-muster.example
# AN das Büro. Bewusst ein eigenes Postfach und nicht buero@:
#   · die Zugangsdaten der Chefin liegen nirgends auf dem Server
#   · im Posteingang ist sofort sichtbar, dass die Notiz vom Assistenten kommt
#   · einzeln abschaltbar, ohne den Mailverkehr des Büros anzufassen

# Empfängerin der Buchungs-Mail (das Büro der Tanzschule).
MAIL_TO=buero@tanzschule-muster.example

# Absender = das Postfach des Assistenten. MUSS mit SMTP_USER übereinstimmen:
# der Mail-Hoster akzeptiert als Absender nur eine Adresse, die zum angemeldeten
# Postfach gehört (oder einen dort eingerichteten Alias). Sonst kommt
# "550 sender address rejected" — und zwar bei JEDER Mail.
# Der Server prüft das beim Start und warnt.
MAIL_FROM=voice-agent@tanzschule-muster.example

# SMTP Pflicht für den Produktivbetrieb — ohne SMTP_HOST wird die Mail nur
# als Datei in outbox/ abgelegt (Test-Fallback).
#
# der Mail-Hoster:
#   SMTP_PORT 465 = implizites TLS/SSL (von der Mail-Hoster empfohlen).
#                   587 nur nutzen, wenn 465 im Netz blockiert ist (STARTTLS).
#   SMTP_USER     = die VOLLSTÄNDIGE E-Mail-Adresse, nicht nur "voice-agent".
#   SMTP_PASS     = das POSTFACH-Passwort, das beim Anlegen des Postfachs
#                   vergeben wurde — NICHT das Passwort des Hoster-Kundenkontos.
#
# Schnelltest der Zugangsdaten ohne diesen Server: mit exakt diesem Paar bei
# webmail.example.com einloggen. Klappt das Webmail, klappt auch SMTP.
#
# Der Login wird beim Serverstart geprüft — ein Tippfehler fällt damit auf,
# bevor die erste echte Anfrage daran scheitert.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=voice-agent@tanzschule-muster.example
SMTP_PASS=

# ── Löschkonzept / Datensparsamkeit ────────────────────────────
# Volltranskript in der Büro-Mail:
#   fehlerfall (Default) = nur wenn die automatische Auswertung gescheitert ist.
#                          Dann ist das Transkript die einzige Rettung der
#                          Anfrage; sonst steht oben in der Mail ohnehin alles.
#   immer                = jedes Wort jedes Gesprächs ins Büropostfach.
# Das Transkript liegt UNABHÄNGIG davon vollständig in outbox/*.json auf dem
# Server — dort ist es für Prompt-Tuning und Auswertung greifbar und wird
# automatisch gelöscht, statt dauerhaft in einem Postfach zu liegen.
MAIL_TRANSKRIPT=fehlerfall

# Aufbewahrung der technischen Kopien in outbox/ (Tage). 0 = nie löschen.
# UNZUSTELLBAR-* ist ausgenommen und bleibt immer liegen.
# Für die Evaluierungsphase nach dem Go-Live ruhig höher setzen (z. B. 90),
# danach wieder senken.
OUTBOX_AUFBEWAHRUNG_TAGE=30

# Optional, aber empfohlen: Adresse der technischen Betreuung. Bekommt eine
# Benachrichtigung, wenn eine Anfrage dem Büro NICHT zugestellt werden konnte
# (z. B. Postfach voll). Ohne diesen Eintrag bleibt es beim Server-Log und
# der Datei unter outbox/UNZUSTELLBAR-*.
ALERT_MAIL_TO=

# ── Server ─────────────────────────────────────────────────────
PORT=3000
# Netzwerk-Interface. UNBEDINGT auf 127.0.0.1 lassen — über diesen Port meldet
# Asterisk die Rufnummer, und mehr muss von außen niemand erreichen.
HTTP_HOST=127.0.0.1

# ── Browser-Demo ───────────────────────────────────────────────
# LEER LASSEN im Produktivbetrieb. Ohne diesen Schalter gibt es keine
# Demo-Seite, keinen /config-Endpunkt und keinen WebSocket — der Server macht
# dann nur noch Telefon.
#
# Warum aus: Die Demo hat keine Anmeldung. Wer den WebSocket erreicht, startet
# Gemini-Sitzungen auf dem Schlüssel der Kundin und kann Mails ans Büro
# auslösen — ohne Zeitlimit, denn das sitzt im Telefonpfad. Auf dem Server
# braucht sie niemand: Getestet wird mit pruef/anruf.mjs und am echten Telefon.
#
# Lokal einschalten mit "npm run demo" (setzt --demo) oder hier DEMO_UI=on.
DEMO_UI=
# Wenn die Demo läuft: erlaubte Herkunftsseiten des WebSockets, Komma-getrennt.
# Leer = http://localhost:PORT und http://127.0.0.1:PORT. Nur nötig, wenn die
# Seite über einen abweichenden Port oder Hostnamen aufgerufen wird.
DEMO_ORIGINS=

# ── Telefon (Asterisk AudioSocket) ─────────────────────────────
# Produktivbetrieb am Festnetz (siehe deploy/README.md).
# PHONE_ENABLED=false schaltet die Telefon-Anbindung ab (reine Browser-Demo).
PHONE_ENABLED=true
# Nur lokal binden — Asterisk läuft auf demselben VPS, kein Port ins Internet.
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=8090
# Weiterverbinden an einen Menschen (Tool menschVerbinden): VOR dieser Stunde
# (Europe/Berlin) wird ans Festnetz-Telefon durchgestellt, AB dieser Stunde nur
# noch ein dringender Rückrufwunsch als [DRINGEND]-Mail notiert. Default 18.
# Das eigentliche Anwähl-Ziel steht als TRANSFER_TARGET in der Asterisk-
# extensions.conf, nicht hier.
TRANSFER_UNTIL_HOUR=18

# ── Dashboard für die Kundin ───────────────────────────────────
# Zwei getrennte Teile, siehe deploy/DASHBOARD.md:
#   dashboard/bauen.js   rechnet protokoll/anrufe.jsonl zu einer Seite zusammen
#   dashboard/server.js  liefert genau diese Seite aus, sonst nichts
#
# DASHBOARD_PFAD ist die zweite Schutzschicht hinter dem VPN — ein langer, nicht
# erratbarer Pfad statt Login. Der Dienst startet nicht ohne. Erzeugen mit:
#   node -e "console.log('/'+require('crypto').randomBytes(24).toString('base64url'))"
# Der Link bleibt ein Geheimnis: nicht in Chats, Tickets oder Screenshots.
DASHBOARD_PFAD=
DASHBOARD_PORT=8080
# Die WireGuard-Adresse des VPS. Das Dashboard ist NUR aus dem Netz der Kundin
# erreichbar, kein Port zeigt ins Internet. Ohne Angabe bindet der Dienst auf
# 127.0.0.1; 0.0.0.0 waere eine bewusste Oeffnung und ist hier nicht gewollt.
DASHBOARD_HOST=10.0.0.201

# Preise für die KOSTENNÄHERUNG (USD je 1 Mio. Token, Paid Tier). Stand
# 19.08.2026 von ai.google.dev/gemini-api/docs/pricing für
# gemini-3.1-flash-live-preview. Getrennt nach Modalität, weil gesprochene
# Antworten das Sechzehnfache von eingehendem Text kosten — eine Gesamtsumme
# ergäbe eine Schätzung, die um eine Größenordnung danebenliegen kann.
# Ändern, wenn Google die Preise anpasst oder das Live-Modell wechselt.
PREIS_EIN_TEXT_USD=0.75
PREIS_EIN_AUDIO_USD=3.00
PREIS_AUS_TEXT_USD=4.50
PREIS_AUS_AUDIO_USD=12.00
# Nur für die Anzeige in Euro. Grob, wie die ganze Näherung.
USD_EUR_KURS=0.92

# Ablageort des Betriebsprotokolls (eine JSON-Zeile je Anruf, ohne
# Personenbezug). Leer = protokoll/anrufe.jsonl im Projektordner.
ANRUF_LOG=

# Harte Gesprächsobergrenze in Minuten (0 = aus, nicht empfohlen).
# Eine Minute vor Ablauf wird die Assistentin angewiesen, das Gespräch
# freundlich abzuschließen; danach wird ausgeredet und aufgelegt.
# Warum das nötig ist: Eine offen gelassene Leitung verbraucht durchgehend
# Gemini-Minuten. Der Spend Cap deckelt zwar die Rechnung — aber wenn er
# greift, pausieren ALLE Requests bis zum nächsten Abrechnungszyklus und das
# Telefon fällt komplett aus. Ein vergessenes Gespräch darf nicht den Dienst
# für den Rest des Monats kosten.
MAX_GESPRAECH_MIN=10
